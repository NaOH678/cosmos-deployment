+void WujiHandDriverNode::recover_to_initial_callback(
+    const std::shared_ptr<std_srvs::srv::Trigger::Request> /*request*/,
+    std::shared_ptr<std_srvs::srv::Trigger::Response> response) {
+  if (!hardware_connected_ || !hand_ || !controller_) {
+    response->success = false;
+    response->message = "Hardware not connected";
+    return;
+  }
+  if (initial_position_.size() != NUM_JOINTS) {
+    response->success = false;
+    response->message =
+        "initial_position is not configured for this hand (expected 20 radians)";
+    return;
+  }
+
+  std::lock_guard<std::mutex> control_lock(control_mutex_);
+  if (recovery_active_) {
+    response->success = false;
+    response->message = "Hand Recovery is already running";
+    return;
+  }
+  if (external_commands_enabled_) {
+    response->success = false;
+    response->message = "Disable external hand control before Recovery";
+    return;
+  }
+
+  try {
+    std::lock_guard<std::mutex> hardware_lock(hardware_mutex_);
+    hand_->read<wujihandcpp::data::joint::ActualPosition>();
+    double measured_positions[NUM_FINGERS][JOINTS_PER_FINGER] = {};
+    for (size_t f = 0; f < NUM_FINGERS; ++f) {
+      for (size_t j = 0; j < JOINTS_PER_FINGER; ++j) {
+        const size_t index = to_flat_index(f, j);
+        const double position =
+            hand_->finger(f).joint(j).get<wujihandcpp::data::joint::ActualPosition>();
+        measured_positions[f][j] = position;
+        recovery_start_positions_[index] = position;
+        last_target_positions_[index] = position;
+        command_ramp_start_positions_[index] = position;
+      }
+    }
+
+    // Seed the realtime controller at the measured posture before applying
+    // power. The Recovery timer is then the only target writer until READY.
+    controller_->set_joint_target_position(measured_positions);
+    command_stream_active_ = false;
+    recovery_ready_ = false;
+    external_commands_enabled_ = false;
+    recovery_start_time_ = std::chrono::steady_clock::now();
+    recovery_active_ = true;
+    hand_->write<wujihandcpp::data::joint::Enabled>(true);
+    enabled_.store(true);
+    publish_recovery_state(RECOVERY_MOVING);
+
+    response->success = true;
+    response->message = "Hand Recovery started; external commands are blocked";
+    RCLCPP_INFO(this->get_logger(),
+                "Hand Recovery started: measured posture -> configured initial posture in %.1fs",
+                recovery_duration_);
+  } catch (const std::exception& e) {
+    recovery_active_ = false;
+    recovery_ready_ = false;
+    external_commands_enabled_ = false;
+    enabled_.store(false);
+    try {
+      std::lock_guard<std::mutex> hardware_lock(hardware_mutex_);
+      hand_->write<wujihandcpp::data::joint::Enabled>(false);
+    } catch (const std::exception& disable_error) {
+      RCLCPP_ERROR(this->get_logger(), "Failed to disable after Recovery start error: %s",
+                   disable_error.what());
+    }
+    publish_recovery_state(RECOVERY_FAILED);
+    response->success = false;
+    response->message = std::string("Hand Recovery failed to start: ") + e.what();
+  }
+}
+
+void WujiHandDriverNode::update_recovery() {
+  std::lock_guard<std::mutex> control_lock(control_mutex_);
+  if (!recovery_active_ || !hardware_connected_ || !controller_) {
+    return;
+  }
+
+  try {
+    const double elapsed = std::chrono::duration<double>(
+        std::chrono::steady_clock::now() - recovery_start_time_).count();
+    const double phase = recovery_duration_ <= 0.0
+                             ? 1.0
+                             : std::clamp(elapsed / recovery_duration_, 0.0, 1.0);
+    const double blend = phase * phase * (3.0 - 2.0 * phase);
+    double positions[NUM_FINGERS][JOINTS_PER_FINGER] = {};
+    for (size_t i = 0; i < NUM_JOINTS; ++i) {
+      const double target = recovery_start_positions_[i] +
+                            blend * (initial_position_[i] - recovery_start_positions_[i]);
+      positions[i / JOINTS_PER_FINGER][i % JOINTS_PER_FINGER] = target;
+      last_target_positions_[i] = target;
+    }
+    controller_->set_joint_target_position(positions);
+
+    if (phase >= 1.0) {
+      const auto& actual = controller_->get_joint_actual_position();
+      double max_error = 0.0;
+      for (size_t f = 0; f < NUM_FINGERS; ++f) {
+        for (size_t j = 0; j < JOINTS_PER_FINGER; ++j) {
+          const size_t index = to_flat_index(f, j);
+          max_error = std::max(
+              max_error,
+              std::abs(actual[f][j].load() - initial_position_[index]));
+        }
+      }
+      if (max_error <= recovery_tolerance_) {
+        recovery_active_ = false;
+        recovery_ready_ = true;
+        command_stream_active_ = false;
+        publish_recovery_state(RECOVERY_READY);
+        RCLCPP_INFO(
+            this->get_logger(),
+            "Hand Recovery complete (max error %.4f rad); holding initial posture until Enable",
+            max_error);
+      } else if (elapsed >= recovery_duration_ + recovery_settle_timeout_) {
+        throw std::runtime_error(
+            "actual joints did not converge to initial_position; max error=" +
+            std::to_string(max_error) + " rad");
+      }
+    }
+  } catch (const std::exception& e) {
+    recovery_active_ = false;
+    recovery_ready_ = false;
+    external_commands_enabled_ = false;
+    command_stream_active_ = false;
+    enabled_.store(false);
+    try {
+      std::lock_guard<std::mutex> hardware_lock(hardware_mutex_);
+      hand_->write<wujihandcpp::data::joint::Enabled>(false);
+    } catch (const std::exception& disable_error) {
+      RCLCPP_ERROR(this->get_logger(), "Failed to disable after Recovery error: %s",
+                   disable_error.what());
+    }
+    publish_recovery_state(RECOVERY_FAILED);
+    RCLCPP_ERROR(this->get_logger(), "Hand Recovery failed: %s", e.what());
+  }
+}
