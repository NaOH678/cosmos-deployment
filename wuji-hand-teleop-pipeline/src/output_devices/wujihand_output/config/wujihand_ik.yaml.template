# Wuji Hand unified configuration — single source of truth for hand parameters.
#
# This file is loaded by:
#   1. wujihand_controller node (via -c flag)
#   2. launch files (via wuji_teleop_bringup.hand_defaults module)
#
# ===== Glove integration contract =====
#
# Per-side controller processes (wujihand_controller_{left,right}) subscribe
# directly to the input source selected below — there is no intermediate
# /hand_input bridge topic anymore.
#
#   wuji_glove: in-process UDP via wuji_sdk (no ROS topic).
#   manus:      ROS2 topic /manus_glove_{0,1} (manus_ros2_msgs/ManusGlove),
#               filtered by msg.side. Published by manus_ros2 C++ driver.
#
# Each controller converts its side's raw data to MediaPipe 21-point format
# (21 x 3 floats) and feeds it into the retargeter.
#
# To add a new glove:
#   1. Add a branch in controller/wujihand_node.py that produces MediaPipe
#      (21, 3) keypoints for one side.
#   2. Add retarget config(s): config/retarget_{source}.yaml (shared) or
#      config/retarget_{source}_{left,right}.yaml (per-side).
#   3. Add the new value to input_source below.
#
# Supported today: wuji_glove (default), manus

# Input source — selects the matching retarget config.
#   wuji_glove (default, UDP)  — glove SNs in wuji_glove package config/wuji_glove.yaml
#   manus      (USB dongle)
input_source: "wuji_glove"

# ===== Wuji Hand hardware =====
# Find serials with: lsusb -v -d 0483:2000 | grep iSerial
left_hand:
  serial_number: "YOUR_LEFT_HAND_SERIAL"
  name: "left_hand"           # wujihandros2 driver namespace
  # Capture the physical left hand separately; do not mirror right-hand data.
  initial_position: []

right_hand:
  serial_number: "YOUR_RIGHT_HAND_SERIAL"
  name: "right_hand"          # wujihandros2 driver namespace
  # Fixed Recovery posture captured on Robotics54 on 2026-08-06.
  # Units: radians; finger1..5, four joints per finger.
  initial_position:
    - 0.439697
    - 0.317632
    - 0.479278
    - -0.060648
    - 0.412778
    - 0.028176
    - -0.034732
    - 0.469763
    - 0.454828
    - -0.083831
    - 0.012029
    - 0.445266
    - 0.385321
    - -0.010488
    - 0.056614
    - 0.586460
    - 0.387074
    - -0.129926
    - 0.022691
    - 0.657049

# ===== wujihandros2 driver parameters =====
driver:
  publish_rate: 1000.0        # driver publish rate (Hz)
  filter_cutoff_freq: 10.0    # hardware low-pass filter cutoff (Hz)
  diagnostics_rate: 10.0      # diagnostics publish rate (Hz)
  recovery_duration: 5.0      # smooth measured-position -> initial-position move
  recovery_tolerance: 0.12    # max actual-vs-target error accepted at Recovery (rad)
  recovery_settle_timeout: 2.0  # extra hold time allowed to converge (seconds)
