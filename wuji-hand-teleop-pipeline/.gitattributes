*.so filter=lfs diff=lfs merge=lfs -text
*.so.* filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text

# Unified diff files encode blank context lines as one leading space. Do not
# treat that required patch syntax as trailing-whitespace damage.
patches/*.patch whitespace=-blank-at-eol

# Extension-less Linux ELF binaries vendored with XRoboToolkit PC-Service:
# ConsoleDemo / RobotDataRecorder / RobotDemoQt are large debug-symbol-laden
# pre-built tools shipped alongside the daemon. Track them in LFS so the
# repo stays small.
src/input_devices/pico_input/vendor/XRoboToolkit-PC-Service/RoboticsService/Redistributable/linux/ConsoleDemo filter=lfs diff=lfs merge=lfs -text
src/input_devices/pico_input/vendor/XRoboToolkit-PC-Service/RoboticsService/Redistributable/linux/RobotDataRecorder filter=lfs diff=lfs merge=lfs -text
src/input_devices/pico_input/vendor/XRoboToolkit-PC-Service/RoboticsService/Redistributable/linux/RobotDemoQt filter=lfs diff=lfs merge=lfs -text
